# Ubuntu 22.04 기반 (EnergyPlus 공식 지원 OS)
FROM ubuntu:22.04

# 상호작용 없는 설치 설정
ENV DEBIAN_FRONTEND=noninteractive

# 기본 의존성 설치 (Python, pip, curl 등)
RUN apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3-pip curl wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 파이썬 기본 명령어 설정
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# EnergyPlus 24.1.0 다운로드 및 설치
# (자동 Y 입력으로 라이선스 동의 및 기본 디렉토리 설치 진행)
RUN wget https://github.com/NREL/EnergyPlus/releases/download/v24.1.0/EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu22.04-x86_64.tar.gz -O /tmp/ep.tar.gz \
    && mkdir -p /usr/local/EnergyPlus-24-1-0 \
    && tar -xzf /tmp/ep.tar.gz -C /usr/local/EnergyPlus-24-1-0 --strip-components=1 \
    && rm /tmp/ep.tar.gz \
    && ln -s /usr/local/EnergyPlus-24-1-0/energyplus /usr/local/bin/energyplus

# 작업 디렉토리 설정
WORKDIR /app

# 의존성 패키지 파일 복사 및 설치
COPY green-retrofit-backend/requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt

# DB 폴더와 백엔드 소스코드 복사
COPY _data/ ./_data/
COPY green-retrofit-backend/ ./green-retrofit-backend/

# 컨테이너 내 EnergyPlus 버전 환경변수 설정 (시뮬레이터용)
ENV EP_VERSION="24.1"

# 실행 디렉토리를 백엔드 소스코드로 변경
WORKDIR /app/green-retrofit-backend

# 포트 개방 (Render 기본 10000 포트)
ENV PORT=10000

# 서버 실행 (slowapi, fastapi 모두 uvicorn으로 실행)
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port $PORT"]
