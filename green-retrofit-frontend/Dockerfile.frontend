FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm install

COPY . .
# 백엔드 API 호출을 Nginx 프록시를 통해 상대경로(/)로 가도록 설정
ENV VITE_API_BASE_URL="/"
RUN npm run build

FROM nginx:alpine
# 빌드된 정적 파일 복사
COPY --from=build /app/dist /usr/share/nginx/html
# 커스텀 Nginx 설정 복사 (API 프록시 및 React 라우팅 지원)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
